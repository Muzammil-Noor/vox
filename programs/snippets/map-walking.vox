main {
    map<string, integer> ages <- {"ada": 36, "alan": 41, "grace": 45};

    say keys of ages;
    say values of ages;

    // for each gives you the keys, in the order they were set
    for each name in ages {
        say name, " is ", ages[name];
    }

    // counting is what maps are for
    string[] words <- ["red", "blue", "red"];
    map<string, integer> counts <- {};
    for each w in words {
        counts[w] <- (counts[w] otherwise 0) + 1;
    }
    say counts;
}
